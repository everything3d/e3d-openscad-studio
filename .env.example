# Postgres connection string.
# Local dev: any Postgres works, e.g. postgres://<user>@localhost:5432/e3d_openscad_studio
# On Vercel: provisioned automatically when you add Neon (or another Postgres) from the Marketplace.
POSTGRES_URL=

# Claude API key (https://platform.claude.com/settings/keys).
# Required in every environment, including on Vercel.
ANTHROPIC_API_KEY=

# Optional: override the agent model (default: claude-opus-5-5). Any current
# Claude model id; it must support tool calling and image input (users attach
# reference photos and sketches). Ids that are not Claude ids are ignored.
# STUDIO_MODEL=claude-opus-5-5

# Optional: how much the agent thinks before answering: low, medium, high,
# xhigh or max (default: medium). Higher is slower and costs more.
# STUDIO_EFFORT=medium

# Optional: override the model that auto-names projects (default: claude-haiku-5-5).
# NAMING_MODEL=claude-haiku-5-5

# Optional: model used to draft reusable starter metadata (default: NAMING_MODEL).
# STARTER_DRAFT_MODEL=claude-haiku-5-5

# Clerk (auto-provisioned when added via Vercel Marketplace: vercel integration add clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional: spend guard. These exist only to stop a runaway script from
# draining the Claude API account — they sit far above real use, and a heavy
# human session does not come close. Set either to 0 to disable that window.
# Rolling windows per signed-in user, counted across every model-calling route.
# MODEL_CALLS_PER_DAY=500
# MODEL_CALLS_PER_MINUTE=20

# Optional: override the WhatsApp number behind the "Chat with us" button.
# Defaults to the Everything 3D business line used on everything3dindia.com.
# NEXT_PUBLIC_WHATSAPP_NUMBER=917892554719

# --- Ordering (Shopify) -----------------------------------------------------
# Ordering stays hidden until the store AND one set of credentials are present,
# so a deployment without them serves the whole studio with no order button.
#
# Your store, with or without the .myshopify.com suffix.
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
#
# Then ONE of the two below.
#
# (a) An existing admin-created custom app (Settings -> Apps and sales channels
#     -> Develop apps). Shopify no longer lets you create these, but existing
#     ones keep working and their token does not expire. Simplest if you have one.
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...
#
# (b) An app created in the Shopify Dev Dashboard (dev.shopify.com), which is
#     the only way to make a new one. Its tokens last 24 hours, so the app
#     exchanges these for one and refreshes it automatically.
#     Requires the app and the store to be in the same Shopify organization.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
#
# Either way the app needs the write_draft_orders and read_draft_orders Admin
# API scopes. These are server-side secrets: never prefix with NEXT_PUBLIC_.
#
# Optional: the shop's presentment currency. Draft order prices are expressed
# in it, and Shopify converts if it does not match, which would change what the
# customer is charged. Default INR.
# SHOPIFY_CURRENCY=INR

# Pricing, in whole rupees. A quote is baseFee + time + material, never below
# the minimum. Defaults shown.
# ORDER_BASE_FEE_INR=149
# ORDER_HOURLY_RATE_INR=100
# ORDER_MATERIAL_RATE_INR_PER_GRAM=2
# ORDER_MINIMUM_INR=299

# How many orders one account may raise per hour. Draft orders land in the
# Shopify admin for a person to review, so this keeps that queue usable.
# ORDERS_PER_HOUR=10

# Staff admin (/admin): Google sign-in limited to @everything3dindia.com accounts,
# via Auth.js — separate from Clerk. Same Google OAuth client as the figurine
# studio's /admin; add https://<this domain>/api/auth/callback/google to its
# authorized redirect URIs. AUTH_SECRET: `npx auth secret` or any 32+ random bytes.
# AUTH_SECRET=...
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
